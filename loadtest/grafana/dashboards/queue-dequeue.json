      "id": 3,
      "title": "HTTP failure rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(k6_http_req_failed_rate{operation=\"dequeue\",testid=~\"$testid\"})",
          "refId": "A"
        }
      ]
