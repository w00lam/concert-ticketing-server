      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Dequeue latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(k6_http_req_duration_p95{operation=\"dequeue\",testid=~\"$testid\"})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
